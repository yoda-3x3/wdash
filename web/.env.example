# --- GitHub OAuth app (Settings > Developer settings > OAuth Apps) ---
GITHUB_ID=
GITHUB_SECRET=
# GitHub logins that may sign in, comma separated (e.g. me,me-school).
ALLOWED_GITHUB_LOGIN=
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# --- Upstash Redis (REST) ---
UPSTASH_REDIS_REST_URL=      # not needed if you used Vercel's Upstash integration (KV_REST_API_URL)
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub token for workflow_dispatch + archive (fine-grained PAT) ---
# Repository access: your allowlisted project repos + the wdash repo.
# Permissions: Actions: read/write, Contents: read/write.
GITHUB_DISPATCH_TOKEN=
WDASH_ARCHIVE_REPO=         # owner/wdash
# Project repos owned by another account need that account's token, one per owner:
# GITHUB_TOKEN_FOR_<OWNER, uppercased, non-alphanumerics as _>, e.g. GITHUB_TOKEN_FOR_MY_SCHOOL=

# --- Web Push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- External cron (QStash / cron-job.org) hitting /api/cron/reconcile ---
CRON_SECRET=
