# Upstash Redis over TCP (Upstash console > your DB > "TCP" / ioredis connection string)
WDASH_REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
# Your Vercel URL, used in notification links
WDASH_WEB_URL=https://your-wdash.vercel.app
# Same VAPID keys as the web app (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: lets agents deploy to Vercel (vercel_deploy). Create a token at https://vercel.com/account/tokens
# VERCEL_TOKEN=
# Vercel team slug, if deploys should go to a team instead of your personal account
# VERCEL_SCOPE=
# Optional
# WDASH_STALL_MINUTES=10

# Kaggle model server (wdash-daemon kaggle up). Token goes in ~/.kaggle/access_token.
KAGGLE_USERNAME=
# KAGGLE_MODELS=qwen3.8:27b,qwen3-coder:30b
# Second Kaggle server on another account (token in ~/.kaggle/access_token_2):
# KAGGLE_USERNAME_2=
# KAGGLE_MAX_SERVERS=2
